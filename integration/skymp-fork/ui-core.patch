+  display: "Darstellung",
+  scale: "UI-Skalierung",
+  visible: "Sichtbar",
+  position: "Position",
+  info: "Hinweis",
+  success: "Erfolg",
+  warning: "Warnung",
+  error: "Fehler",
+  pending: "Warte auf Server \u2026",
+  language: "Sprache / Language",
+  "top-left": "Oben links",
+  "top-right": "Oben rechts",
